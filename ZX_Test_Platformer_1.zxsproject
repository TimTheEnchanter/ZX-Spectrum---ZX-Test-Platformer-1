  "scripts": [
    {
      "id": "script-patrol",
      "name": "Patrol",
      "blocks": [
        {
          "kind": "ifBlocked",
          "then": [
            {
              "kind": "flipDirection"
            }
          ],
          "else": [
            {
              "kind": "moveForward"
            }
          ]
        }
      ]
    },
    {
      "id": "script-chase",
      "name": "Sentinel",
      "blocks": [
        {
          "kind": "ifPlayerAligned",
          "then": [
            {
              "kind": "moveTowardPlayer"
            }
          ],
          "else": []
        }
      ]
    },
    {
      "id": "script-round",
      "name": "Round",
      "blocks": [
        {
          "kind": "ifBlocked",
          "then": [
            {
              "kind": "flipDirection"
            },
            {
              "kind": "wait",
              "frames": 30
            }
          ],
          "else": [
            {
              "kind": "moveForward"
            }
          ]
        }
      ]
    },
    {
      "id": "script-wander",
      "name": "Wanderer",
      "blocks": [
        {
          "kind": "ifChance",
          "oneIn": 8,
          "then": [
            {
              "kind": "flipDirection"
            }
          ],
          "else": []
        },
        {
          "kind": "moveForward"
        }
      ]
    },
    {
      "id": "script-hunter",
      "name": "Hunter",
      "blocks": [
        {
          "kind": "moveTowardPlayer"
        }
      ]
    },
    {
      "id": "script-charger",
      "name": "Charger",
      "blocks": [
        {
          "kind": "ifPlayerAligned",
          "then": [
            {
              "kind": "moveTowardPlayer"
            },
            {
